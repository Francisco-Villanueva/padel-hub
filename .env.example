# Conexiones pooled de Neon, una por rol (ver app/drizzle/0001_rls.sql)
DATABASE_URL=postgresql://app_user:CHANGE_ME@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_PLATFORM=postgresql://platform_user:CHANGE_ME@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Conexión DIRECTA (sin -pooler) con el rol dueño de las tablas, solo para migraciones
DATABASE_URL_MIGRATE=postgresql://neondb_owner:CHANGE_ME@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Auth (ver docs/system-design.md 3.1). Mínimo 32 caracteres aleatorios:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# Landing: destino de "Probalo en tu club" (mailto: o https://wa.me/...). Sin definir, abre un correo vacio.
LANDING_CONTACT_URL=
# Landing: "Agendá una demo" (Calendly de los sábados, https://...). Sin definir, usa LANDING_CONTACT_URL.
LANDING_DEMO_URL=
# Landing: botón flotante de WhatsApp en celular (https://wa.me/...). Sin definir, no se muestra.
LANDING_WHATSAPP_URL=
